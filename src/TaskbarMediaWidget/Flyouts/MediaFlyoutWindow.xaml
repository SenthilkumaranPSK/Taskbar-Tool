<Window x:Class="TaskbarMediaWidget.Flyouts.MediaFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Now Playing"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="350"
        SizeToContent="Height"
        Focusable="True"
        ShowActivated="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutBgBrush" Color="#F2202020" />
        <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="White" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ActiveControlBrush" Color="#4060CDFF" />

        <Style x:Key="FlyoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2,0,0,2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="#33FFFFFF" CornerRadius="0,2,2,0" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource PrimaryTextBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12" Background="{DynamicResource FlyoutBgBrush}"
            BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Art + Meta -->
                <RowDefinition Height="Auto" /> <!-- Scrubber -->
                <RowDefinition Height="Auto" /> <!-- Controls -->
            </Grid.RowDefinitions>

            <!-- Header: App Badge & Close -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Border HorizontalAlignment="Left" Background="#18FFFFFF" CornerRadius="4" Padding="6,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="SourceAppText" Text="Media Player" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="CloseButton" Style="{StaticResource FlyoutButtonStyle}" HorizontalAlignment="Right" Width="24" Height="24" Content="" FontSize="10" Click="CloseButton_Click" ToolTip="Close Flyout" />
            </Grid>

            <!-- Art + Title / Artist / Album -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="72" Height="72" CornerRadius="8" ClipToBounds="True" Background="#18FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid>
                        <TextBlock x:Name="ArtFallbackGlyph" Text="" FontFamily="Segoe Fluent Icons" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Image x:Name="CoverArtImage" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TrackTitleText" Text="Title" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" Text="Artist" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AlbumText" Text="Album" FontSize="11" Foreground="#70FFFFFF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- Timeline Scrubber -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Slider x:Name="SeekSlider" Grid.Row="0" Style="{StaticResource SeekSliderStyle}"
                        Minimum="0" Maximum="100" Value="0"
                        PreviewMouseDown="SeekSlider_PreviewMouseDown"
                        PreviewMouseUp="SeekSlider_PreviewMouseUp" />

                <Grid Grid.Row="1" Margin="2,-2,2,0">
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="TotalTimeText" Text="0:00" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <!-- Controls: Shuffle, Prev, Play/Pause, Next, Repeat -->
            <Grid Grid.Row="3" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ShuffleButton" Style="{StaticResource FlyoutButtonStyle}" Width="32" Height="32" Content="" FontSize="14" Click="ShuffleButton_Click" ToolTip="Shuffle" Margin="0,0,8,0" />
                    <Button x:Name="PrevButton" Style="{StaticResource FlyoutButtonStyle}" Width="36" Height="36" Content="" FontSize="15" Click="PrevButton_Click" ToolTip="Previous Track" Margin="0,0,6,0" />
                    <Button x:Name="PlayPauseButton" Style="{StaticResource FlyoutButtonStyle}" Width="44" Height="44" Content="" FontSize="20" Click="PlayPauseButton_Click" ToolTip="Play / Pause" Background="{DynamicResource HoverBrush}" Margin="0,0,6,0" />
                    <Button x:Name="NextButton" Style="{StaticResource FlyoutButtonStyle}" Width="36" Height="36" Content="" FontSize="15" Click="NextButton_Click" ToolTip="Next Track" Margin="0,0,8,0" />
                    <Button x:Name="RepeatButton" Style="{StaticResource FlyoutButtonStyle}" Width="32" Height="32" Content="" FontSize="14" Click="RepeatButton_Click" ToolTip="Repeat" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
