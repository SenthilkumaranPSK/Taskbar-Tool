<Window x:Class="TaskbarMediaWidget.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Tool Settings"
        Width="500"
        Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsBgBrush" Color="#F21E1E20" />
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#16FFFFFF" />
        <SolidColorBrush x:Key="SettingsBorderBrush" Color="#2BFFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />

        <Style x:Key="FluentCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="WindowHeaderBtn" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12"
            Background="{DynamicResource SettingsBgBrush}"
            BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
        </Border.Effect>

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 0: Header with Drag -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="Header_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Taskbar Tool Settings" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource WindowHeaderBtn}" Content="&#xE711;" Click="Close_Click" ToolTip="Close" />
            </Grid>

            <!-- 1: Scrollable Settings Options -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <!-- Section: General -->
                    <TextBlock Text="GENERAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,4,0,6" />
                    <Border Background="{DynamicResource SettingsCardBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="ChkStartup" Style="{StaticResource FluentCheckBox}" Content="Run at Windows startup" Click="ChkStartup_Click" />
                            <CheckBox x:Name="ChkGlobalHotkey" Style="{StaticResource FluentCheckBox}" Content="Global shortcut (Win + Shift + Z) to toggle flyout" Click="ChkGlobalHotkey_Click" />
                            <CheckBox x:Name="ChkHideWhenIdle" Style="{StaticResource FluentCheckBox}" Content="Hide widget completely when nothing is playing" Click="ChkHideWhenIdle_Click" />
                            <CheckBox x:Name="ChkDiscordRpc" Style="{StaticResource FluentCheckBox}" Content="Discord Rich Presence (show now playing in Discord)" Click="ChkDiscordRpc_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Widget Appearance & Layout -->
                    <TextBlock Text="WIDGET APPEARANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,4,0,6" />
                    <Border Background="{DynamicResource SettingsCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Widget Layout Style" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontSize="13" />
                                <ComboBox Grid.Column="1" x:Name="CmbLayout" Width="130" SelectionChanged="CmbLayout_SelectionChanged" Height="26">
                                    <ComboBoxItem Content="Standard" Tag="0" />
                                    <ComboBoxItem Content="Compact" Tag="1" />
                                    <ComboBoxItem Content="Minimal" Tag="2" />
                                    <ComboBoxItem Content="Wide Ticker" Tag="3" />
                                </ComboBox>
                            </Grid>

                            <CheckBox x:Name="ChkTransparency" Style="{StaticResource FluentCheckBox}" Content="Transparency mode (translucent glass style)" Click="ChkTransparency_Click" />
                            <CheckBox x:Name="ChkProgressBar" Style="{StaticResource FluentCheckBox}" Content="Show live track progress bar (bottom 2px)" Click="ChkProgressBar_Click" />
                            <CheckBox x:Name="ChkEqualizer" Style="{StaticResource FluentCheckBox}" Content="Show equalizer bars on taskbar" Click="ChkEqualizer_Click" />
                            <CheckBox x:Name="ChkRealSpectrum" Style="{StaticResource FluentCheckBox}" Content="Real WASAPI audio loopback visualizer (reactive FFT)" Click="ChkRealSpectrum_Click" />

                            <Grid Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Custom Left Edge Margin Offset" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" x:Name="TxtOffsetVal" Text="0 px" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="SldOffset" Minimum="-40" Maximum="250" SmallChange="5" LargeChange="20" ValueChanged="SldOffset_ValueChanged" Margin="0,2,0,0" />
                            <TextBlock Text="Tip: Increase offset if left-aligned Start button or Search bar overlaps widget." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Section: Audio Output & Filters -->
                    <TextBlock Text="AUDIO &amp; FILTERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,4,0,6" />
                    <Border Background="{DynamicResource SettingsCardBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Default Audio Output Device" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,6" />
                            <ComboBox x:Name="CmbAudioDevices" SelectionChanged="CmbAudioDevices_SelectionChanged" Height="28" Margin="0,0,0,12" />

                            <TextBlock Text="Ignored Media Apps (comma separated)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtIgnoredApps" TextChanged="TxtIgnoredApps_TextChanged" Height="26" Padding="4,2" Background="#22FFFFFF" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" />
                            <TextBlock Text="Example: Discord, Steam (ignores voice channels and system media sessions)" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2: Footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                <Grid>
                    <TextBlock Text="Taskbar Tool • v1.1.0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Width="75" Height="28" Content="Done" Background="{DynamicResource AccentBrush}" Foreground="Black" FontWeight="SemiBold" BorderThickness="0" Click="Close_Click" Cursor="Hand" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
